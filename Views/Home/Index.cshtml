<!-- LEGEND -->
<div class="card mb-4 legend-box">
    <div class="card-body">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="card-title mb-0">Attendance Legend</h6>

            <!-- Settings Dropdown -->
            <div class="d-flex align-items-center gap-3">

                    <!-- Dark Mode Toggle -->
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               id="darkModeToggle">
                        <label class="form-check-label small"
                               for="darkModeToggle">
                            🌙 Dark
                        </label>
                    </div>

                    <!-- Settings -->
                    <div class="dropdown">
                        <button class="btn btn-light border d-flex align-items-center gap-2 shadow-sm"
                                type="button"
                                id="settingsDropdown"
                                data-bs-toggle="dropdown">

                            <img src="~/lib/images/settings.png"
                                 width="18"
                                 height="18">

                            <span class="fw-medium">Settings</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   href="#"
                                   data-bs-toggle="modal"
                                   data-bs-target="#standardManpowerModal">
                                    Upload
                                </a>

                                <a class="dropdown-item"
                                   href="#"
                                   data-bs-toggle="modal"
                                   data-bs-target="#templateModal">
                                    Template
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
        </div>

        <!-- Legend Content -->
        <div class="d-flex gap-4 flex-wrap mb-3">
            <span class="legend-text text-danger">■ Lacking MP</span>
            <span class="legend-text text-primary">■ Excess MP</span>
        </div>

        <div class="d-flex gap-3 flex-wrap">
            <span><span class="legend-square" style="background:#ffeb3b;"></span>No Working Day</span>
            <span><span class="legend-square" style="background:#c8e6c9;"></span>Date Today</span>
            <span><span class="legend-square" style="background:#ffffff; border:1px solid #000;"></span>Regular Working Day</span>
            <span><span class="legend-square" style="background:#4caf50;"></span>Local Holiday</span>
            <span><span class="legend-square" style="background:#f44336;"></span>Regular/Legal Holiday</span>
            <span><span class="legend-square" style="background:#2196f3;"></span>Special Holiday</span>
        </div>

    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="standardManpowerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Upload</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <label for="stdFile" class="form-label">
                    Upload STD (Excel)
                </label>
                <input type="file"
                       id="stdFile"
                       class="form-control"
                       accept=".xls,.xlsx">
            </div>

        </div>
    </div>
</div>


<!-- Template Modal -->
<div class="modal fade" id="templateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Upload</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                   <a class="btn btn-success" style="width:100%" href="~/templates/STD_MMS.xlsx">Stadard Manpower Template</a>
            </div>

        </div>
    </div>
</div>
