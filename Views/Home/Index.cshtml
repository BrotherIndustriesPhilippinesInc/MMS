<style>
    .filter-container {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 16px;
        padding: 8px 12px;
    }

    .filter-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        cursor: pointer;
    }

    .filter-item input[type="checkbox"] {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .highlight {
        font-weight: 600;
    }

    .divider {
        width: 1px;
        height: 20px;
        background: #ccc;
    }
</style>
<div class="tab-content">
    <!-- ATTENDANCE -->
    <div class="tab-pane fade show active" id="tab-attendance">

        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title">Manpower Attendance Rate</h6>

                <button class="btn btn-secondary" data-bs-target="#forcastinput" data-bs-toggle="modal">Forcast Input</button>

                <div class="filter-container">
                    <label class="filter-item highlight">
                        <input type="checkbox" id="all" checked />
                        <span>All</span>
                    </label>

                    <div class="divider"></div>

                    <label class="filter-item">
                        <input type="checkbox" id="direct_filter" />
                        <span>Direct + Kitting</span>
                    </label>

                    @* <label class="filter-item"> *@
                    @*     <input type="checkbox" id="kit_filter" /> *@
                    @*     <span>Kit</span> *@
                    @* </label> *@

                    @* <label class="filter-item"> *@
                    @*     <input type="checkbox" id="mso_filter" /> *@
                    @*     <span>MSO</span> *@
                    @* </label> *@
                </div>
               

                @* <div class="table-responsive" style="max-height:500px; overflow:auto;"> *@
                <div class="table-responsive"
                     style="max-height:500px; overflow:auto;">
                    <table class="table table-bordered table-sm" id="attendanceTable">
                        <thead>
                            <tr id="headerRow"></tr>
                            <tr id="subHeaderRow"></tr>
                        </thead>
                        <tbody id="tableBody"></tbody>
                    </table>
                </div>

            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
             
                <div class="row g-3">
                    <!-- Upload STD (Excel) -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm">
                            <thead id="pivotTable"></thead>
                            <tbody id="pivotTableBody"></tbody>
                        </table>
                    </div>
                </div>
                <h6 class="card-title title-green">Process Summary (Original Tap)</h6>
            </div>
        </div>

       <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm">
                            <thead id="retap_table"></thead>
                            <tbody id="retap_tbody"></tbody>
                        </table>
                    </div>
                </div>
                <h6 class="card-title title-purple">Process Summary (Retap Data)</h6>
            </div>
        </div>

        <div class="modal fade" id="forcastinput" tabindex="-1" aria-labelledby="forcastinputModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg border-0 rounded-4">

                    <!-- Header -->
                    <div class="modal-header bg-primary text-white rounded-top-4">
                        <h5 class="modal-title" id="forcastinputModalLabel">
                            📈 Forecast Input Setup
                        </h5>
                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body p-4">

                        <div class="text-center mb-4">
                            <h4 class="fw-bold mb-1">Forecast Parameters</h4>
                            <p class="text-muted mb-0">
                                Select a date range and enter the forecast percentage.
                            </p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                📅 Date From
                            </label>
                            <input type="date"
                                   class="form-control form-control-lg"
                                   id="date_from">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                📅 Date To
                            </label>
                            <input type="date"
                                   class="form-control form-control-lg"
                                   id="date_to">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                📊 Forecast Percentage
                            </label>

                            <div class="input-group">
                                <input type="number"
                                       class="form-control form-control-lg"
                                       id="forecast_percent"
                                       placeholder="Enter percentage"
                                       min="0"
                                       max="100">

                                <span class="input-group-text">
                                    %
                                </span>
                            </div>

                            <small class="text-muted">
                                Example: 85 means 85%
                            </small>
                        </div>

                    </div>

                    <!-- Footer -->
                    <div class="modal-footer border-0 px-4 pb-4">
                        <button type="button"
                                class="btn btn-light border px-4"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-primary px-4" id="btnSaveForecast">
                            💾 Save Forecast
                        </button>
                    </div>

                </div>
            </div>
        </div>
